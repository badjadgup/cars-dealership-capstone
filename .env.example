# Local defaults are automatic. Set all of these explicitly for deployment.
DEBUG=false
SECRET_KEY=replace-with-a-long-random-secret
SERVICE_API_KEY=replace-with-another-long-random-secret
ALLOWED_HOSTS=your-public-hostname
CSRF_TRUSTED_ORIGINS=https://your-public-hostname
DEALERSHIP_URL=https://your-dealers-service
SENTIMENT_URL=https://your-sentiment-service
MONGODB_URI=mongodb+srv://replace-with-your-private-connection-string
SQLITE_PATH=/data/db.sqlite3
